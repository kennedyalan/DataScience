library(neuralnet)
library(MASS)
data(Boston)
summary(Boston)
normalize <- function(x){
return((x - min(x)) / (max(x) - min(x)))
}
boston_norm <- as.data.frame(lapply(Boston, normalize))
set.seed(123)
index <- sample(1:nrow(boston_norm), round(0.7 * nrow(boston_norm)))
train <- boston_norm[index, ]
test <- boston_norm[-index, ]
modelo_reg <- neuralnet(
medv ~ crim + zn + indus + nox + rm + age + dis + tax + ptratio + lstat,
data = train,
hidden = 5,
linear.output = TRUE
)
plot(modelo_reg)
pred <- compute(modelo_reg, test[, c(
"crim", "zn", "indus", "nox", "rm",
"age", "dis", "tax", "ptratio", "lstat"
)])
head(pred$net.result)
min_medv <- min(Boston$medv)
max_medv <- max(Boston$medv)
valor_real <- pred$net.result * (max_medv - min_medv) + min_medv
valor_real
install.packages("shiny")
install.packages("learnr")
setwd("~/Github/ICC/DataScience/R/Circular/Maquina_soporte_vectorial")
set.seed(2)
dfRadial <- data.frame(x = c(rnorm(100, 0,.2), 3*rnorm(100, 0, .5)),
y = c(rnorm(100, 0,.2), 3*rnorm(100, 0,.5)),
color = rep(c(1,2), each=100))
plot(x = dfRadial$x, y = dfRadial$y, col = dfRadial$color,
pch = rep(c(15,16), each=100),
xlab = "valores x1", ylab = "valores x2")
set.seed(1)
m <- svm(as.factor(color) ~ x + y, data = dfRadial,
kernel = "radial", scale = FALSE, cost = 2, probability = TRUE)
library(e1071)
library(e1071)
summary(m)
coef(m)
predict(m, data.frame(x = 2.5, y = 2))
set.seed(2)
dfRadial <- data.frame(x = c(rnorm(100, 0,.2), 3*rnorm(100, 0, .5)),
y = c(rnorm(100, 0,.2), 3*rnorm(100, 0,.5)),
color = rep(c(1,2), each=100))
plot(x = dfRadial$x, y = dfRadial$y, col = dfRadial$color,
pch = rep(c(15,16), each=100),
xlab = "valores x1", ylab = "valores x2")
set.seed(1)
m.tune <- tune(svm, as.factor(color) ~ ., data = dfRadial,
ranges = list(kernel = c("linear","polynomial","radial","sigmoid"),
cost = c(.1,.2,.5,1,2)))
summary(m.tune)
m <- svm(as.factor(color) ~ x + y, data = dfRadial,
kernel = "radial", scale = FALSE, cost = 2, probability = TRUE)
plot(m, data = dfRadial)
plot(x = dfRadial$x, y = dfRadial$y, col = dfRadial$color,
pch = rep(c(15,16), each=100),
xlab = "valores x1", ylab = "valores x2")
m.lineal <- svm(as.factor(color) ~ x + y, data = dfRadial,
kernel = "linear", scale = FALSE, cost = 2)
mean(predict(m.lineal != dfRadial$color))
mean(predict(m != dfRadial$color))
mean(predict(m.lineal) != dfRadial$color)
mean(predict(m) != dfRadial$color)
