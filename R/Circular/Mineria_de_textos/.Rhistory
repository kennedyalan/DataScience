# Necesitamos clasificar nosotros los libros, lo hacemos por el titulo
titulos <- rownames(matriz_limpia)
# Seccion b.
categoria <- case_when(
grepl("cocina|recetas|receta|cocinera|gastronomia", titulos, ignore.case = TRUE) ~ "cocina",
grepl("historia|histórico|leyenda|biografía|rebelión|argentina|fundación", titulos, ignore.case = TRUE) ~ "historia",
TRUE ~ "otros"
)
table(categoria)
str(categoria)
head(categoria)
print(categoria)
str(titulos)
clear
# Seccion b.
categoria <- case_when(
grepl("cocina|recetas|receta|cocinera|gastronomia|aceite", titulos, ignore.case = TRUE) ~ "cocina",
grepl("historia|histórico|leyenda|biografía|rebelión|argentina|fundación|tratado|actas|diario", titulos, ignore.case = TRUE) ~ "historia",
TRUE ~ "otros"
)
table(categoria)
