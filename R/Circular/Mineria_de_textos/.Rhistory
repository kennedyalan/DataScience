a_sino <- function(m) {
df <- as.data.frame(m > 0)
df[] <- lapply(df, function(col) factor(ifelse(col, "Si", "No"), levels = c("No", "Si")))
df
}
train_crudo <- a_sino(train_crudo)
modelo_crudo <- naive_bayes(as.data.frame(train_crudo, categoria_train, laplace = 1))
